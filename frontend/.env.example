# ═════════════════════════════════════════════════════════════════════════════
#  PLANTILLA DE VARIABLES DE ENTORNO · Futuro Antioquia
#
#  Copie este archivo como `.env.local` y reemplace cada VALOR-AQUI por el real.
#  NUNCA escriba valores reales en este archivo: sí se sube al repositorio.
#  Las mismas variables deben existir en Vercel (Settings → Environment Variables).
# ═════════════════════════════════════════════════════════════════════════════

# ── SUPABASE ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://VALOR-AQUI.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=VALOR-AQUI

# Llave maestra (service_role). SOLO servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=VALOR-AQUI

# ── APP ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── INGRESO ──────────────────────────────────────────────────────────────────
# Si falta cualquiera de estas, ese camino de ingreso queda CERRADO (no abierto).
ADMIN_USER=VALOR-AQUI
ADMIN_PASS=VALOR-AQUI
DIANA_USER=VALOR-AQUI
DIANA_PASS=VALOR-AQUI
AFILIACION_CODE=VALOR-AQUI

# Secreto de firma de la cookie de sesión. Genere uno largo y único:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=VALOR-AQUI

# 1 = el login explica por qué falló (solo para depurar). En internet: 0.
LOGIN_DEBUG=0
